* { font-size: 10.5pt; }
QFrame#RailBar { background: {surface}; border-right: 1px solid {border}; }
QToolButton#Rail { border: none; border-radius: 12px; padding: 6px 2px; color: {muted}; font-size: 9pt; background: transparent; }
QToolButton#Rail:hover { background: {hover}; }
QToolButton#Rail:checked { background: {surface2}; color: {accent}; font-weight: 700; }
QFrame#Card, QFrame#DeckTile, QFrame#StatTile { background: {surface}; border: 1px solid {border}; border-radius: 16px; }
QFrame#DeckTile:hover { border: 1px solid {accent}; }
QLabel#DeckName { font-size: 12.5pt; font-weight: 700; }
QFrame#HomeHero { background: {surface}; border: 1px solid {border}; border-radius: 20px; }
QLabel#HeroTitle { font-size: 19pt; font-weight: 700; }
QLabel#HeroSub { color: {muted}; }
QLabel#HeroStat { font-size: 11.5pt; font-weight: 700; color: {accent}; }
QPushButton { border-radius: 10px; padding: 7px 14px; }
QPushButton#Primary { border-radius: 10px; padding: 8px 20px; }
QPushButton#HeroButton { background: {accent}; color: white; border: none; border-radius: 22px; padding: 10px 28px; font-size: 11.5pt; font-weight: 700; }
QPushButton#HeroButton:disabled { background: {border}; color: {muted}; }
QPushButton#Seg { border-radius: 15px; padding: 5px 14px; background: transparent; }
QPushButton#Seg:checked { background: {accent}; color: white; border-color: {accent}; font-weight: 700; }
QFrame#FlashCard { background: {surface}; border: 1px solid {border}; border-radius: 24px; border-bottom: 4px solid {border}; }
QLabel#CardHint { color: {accent}; font-size: 9pt; font-weight: 700; letter-spacing: 2px; }
QLabel#CardWord { font-size: 34pt; font-weight: 700; }
QLabel#CardIpa { font-family: "Segoe UI"; font-size: 14pt; color: {muted}; }
QLabel#CardBack { font-size: 12pt; }
QFrame#CardSep { background: {border}; margin: 0 80px; }
QPushButton#Grade { background: {surface}; border: 1px solid {border}; border-radius: 12px; font-weight: 600; }
QPushButton#Grade:hover { background: {hover}; }
QPushButton#Choice { background: {surface}; border: 1px solid {border}; border-radius: 12px; font-size: 11.5pt; text-align: left; padding-left: 18px; }
QPushButton#Choice:hover { border-color: {accent}; }
QPushButton#Choice[state="right"] { background: #2f9e44; color: white; border-color: #2f9e44; }
QPushButton#Choice[state="wrong"] { background: #e03131; color: white; border-color: #e03131; }
QLineEdit#AnswerEdit { font-size: 14pt; padding: 9px 14px; border-radius: 12px; }
QLabel#Title { font-size: 19pt; font-weight: 700; }
